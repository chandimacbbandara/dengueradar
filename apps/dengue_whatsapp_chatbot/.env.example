# Copy this file to .env and use credentials from the Vonage API Dashboard.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SANDBOX_NUMBER=
VONAGE_MESSAGES_URL=https://messages-sandbox.nexmo.com/v1/messages

# Optional Flask settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Web LLM assistant (does not affect the Vonage chatbot)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=https://api.openai.com/v1/responses
LLM_TIMEOUT_SECONDS=30
